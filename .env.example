# Mot de passe de la base PostgreSQL (obligatoire)
POSTGRES_PASSWORD=change-me
# Compte administrateur créé au premier démarrage. Sans mot de passe, un mot de passe
# aléatoire est généré et affiché dans les logs : docker compose logs deskpilot
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# URL publique de la console, nécessaire pour OIDC derrière un reverse proxy
PUBLIC_URL=
TZ=Europe/Paris
# Secret partagé entre DeskPilot et hbbs (obligatoire), par ex. : openssl rand -hex 32
HBBS_SECRET=
# open : si DeskPilot ne répond pas, hbbs accepte les connexions. closed : il les refuse.
HBBS_FAIL_MODE=open
